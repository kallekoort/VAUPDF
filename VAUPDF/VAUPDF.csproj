<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>VAUPDF.ico</ApplicationIcon>
		<Version>0.3.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
	</ItemGroup>

	<Target Name="RemoveWebView2WpfReference"
			BeforeTargets="ResolveAssemblyReferences"
			Condition="'$(UseWindowsForms)' == 'true' and '$(UseWPF)' != 'true'">
		<ItemGroup>
			<_WebView2WpfReference Include="@(Reference)"
				Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
			<Reference Remove="@(_WebView2WpfReference)" />
		</ItemGroup>
	</Target>

</Project>
